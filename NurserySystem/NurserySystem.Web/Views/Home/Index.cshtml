@{
    ViewData["Title"] = "الرئيسية";
}

<div class="row">
    <div class="col-12 text-center mb-4">
        <h1 class="display-4">نظام إدارة الحضانة</h1>
        <p class="lead">نظام متكامل لإدارة الحضانات ورياض الأطفال</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white h-100">
            <div class="card-body text-center">
                <i class="bi bi-people-fill display-4"></i>
                <h5 class="card-title mt-3">الأطفال</h5>
                <p class="card-text">إدارة بيانات الأطفال والمشتركين</p>
                <a asp-controller="Children" asp-action="Index" class="btn btn-light">عرض الأطفال</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card bg-success text-white h-100">
            <div class="card-body text-center">
                <i class="bi bi-door-open-fill display-4"></i>
                <h5 class="card-title mt-3">الفصول</h5>
                <p class="card-text">إدارة الفصول والمستويات الدراسية</p>
                <a asp-controller="Classes" asp-action="Index" class="btn btn-light">عرض الفصول</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body text-center">
                <i class="bi bi-calendar-check-fill display-4"></i>
                <h5 class="card-title mt-3">الاشتراكات</h5>
                <p class="card-text">متابعة الاشتراكات والمدفوعات</p>
                <a href="#" class="btn btn-light">عرض الاشتراكات</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card bg-warning text-dark h-100">
            <div class="card-body text-center">
                <i class="bi bi-bar-chart-fill display-4"></i>
                <h5 class="card-title mt-3">التقارير</h5>
                <p class="card-text">تقارير شاملة وتحليلات</p>
                <a href="#" class="btn btn-light">عرض التقارير</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5><i class="bi bi-clock-history"></i> آخر النشاطات</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">تم تسجيل طفل جديد</li>
                    <li class="list-group-item">تم إضافة فصل جديد</li>
                    <li class="list-group-item">تم تحصيل دفعة اشتراك</li>
                </ul>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5><i class="bi bi-exclamation-triangle-fill"></i> تنبيهات</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-bell-fill"></i> هناك 5 اشتراكات ستنتهي خلال أسبوع
                </div>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle-fill"></i> فصل KG1 وصل إلى 80% من سعته
                </div>
            </div>
        </div>
    </div>
</div>
